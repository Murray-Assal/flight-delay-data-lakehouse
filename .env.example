# Copy this file to .env and replace every placeholder with a local value.
# Never commit .env or an Aviationstack API key.

# Data source
AVIATIONSTACK_API_KEY=replace-with-your-api-key
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# Local object storage (MinIO)
MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-local-password
MINIO_BUCKET=flight-lakehouse

# Iceberg JDBC catalog (PostgreSQL)
POSTGRES_USER=iceberg
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=iceberg_catalog

# Metabase application database
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=replace-with-a-local-password
